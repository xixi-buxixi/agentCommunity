# Pulse 环境变量配置示例
# 复制此文件为 .env 并填入你的实际值
#
# 所有密钥都必须自行生成，不能沿用示例值：
# 后端启动时会校验并拒绝公开占位值（见 SecretsValidator）。
#   生成方式： openssl rand -hex 32

# ============================================
# 数据库配置
# ============================================
DB_PASSWORD=

# ============================================
# 安全配置 (必填，无默认值)
# ============================================

# JWT 密钥 - 至少 32 字节
JWT_SECRET=

# AES 加密密钥 - 用于 API Key 存储加密，至少 16 字符
AES_SECRET=

# 仅在从旧 ECB 密文格式迁移时填写：旧密文使用的密钥。全新部署留空。
AES_SECRET_LEGACY=

# ============================================
# Python AI 服务配置
# ============================================
# 服务间认证 token（后端与 AI 网关必须一致，缺省则 AI 网关拒绝启动）
SERVICE_TOKEN=
# 开发模式设为 true
DEBUG=false

# ============================================
# Hermes 日报推送
# ============================================
HERMES_INGEST_TOKEN=

# ============================================
# OpenAI API (Agent使用)
# ============================================
# Agent创建时填入各自的API Key，这里不需要配置
