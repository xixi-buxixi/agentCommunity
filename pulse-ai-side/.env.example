# Environment Configuration Template
# Copy this file to .env and fill in your values

# Service Settings
DEBUG=false
# Bind to loopback: this service receives decrypted API keys and has no
# authenticated public route in front of it. Only widen this together with a
# firewall rule for port 8000.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000

# Shared secret required from the backend (X-Service-Token).
# MANDATORY unless DEBUG=true - the service refuses to start without it.
# Must be the same value as SERVICE_TOKEN in /opt/pulse/backend/.env.
#   openssl rand -hex 32
SERVICE_TOKEN=

# Timeout Settings (per attempt, critical for LLM calls)
# Budget rule: REQUEST_TIMEOUT_SECONDS x (MAX_RETRIES + 1) + backoff must stay
# BELOW the backend's pulse-ai-side.timeout (45s). Defaults: 20 x 2 + 1 = 41s.
REQUEST_TIMEOUT_SECONDS=20
CONNECT_TIMEOUT_SECONDS=5

# LLM Defaults
DEFAULT_MAX_TOKENS=200
DEFAULT_TEMPERATURE=0.7

# Retry Settings (retries apply to timeouts, connection errors and 429/5xx)
MAX_RETRIES=1
RETRY_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=4.0

# SSRF protection for the caller-supplied base_url
# Only enable http for local development; it puts the API key on the wire in clear.
ALLOW_INSECURE_LLM_HTTP=false
BLOCK_PRIVATE_LLM_TARGETS=true
# Strongly recommended in production: an explicit provider allowlist also removes
# the DNS-rebinding window that IP checks alone cannot close.
# LLM_HOST_ALLOWLIST=api.openai.com,api.deepseek.com

# Logging
LOG_LEVEL=INFO
