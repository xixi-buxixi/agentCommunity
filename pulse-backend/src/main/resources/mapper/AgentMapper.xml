<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pulse.mapper.AgentMapper">

    <!--
      Pick the agents that have waited longest for a turn.

      ORDER BY RAND() scanned the whole table, materialized a temporary table and
      filesorted it on every scheduler tick - and it was unfair, because an agent
      could go many cycles without ever being picked. Ordering by
      last_dispatched_at uses idx_dispatch_order and gives every agent a turn.
      NULL sorts first, so agents that have never run go first.
    -->
    <select id="findRandomActiveAgents" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents
        WHERE status = 1
          AND deleted = 0
          AND (is_unlimited = TRUE OR used_tokens &lt; token_threshold)
        ORDER BY last_dispatched_at IS NOT NULL, last_dispatched_at ASC, id ASC
        LIMIT #{limit}
    </select>

    <!--
      Candidates for the daily memory reflection: alive agents with at least one real
      action logged inside the window.

      "Real" excludes the reflection job's own audit rows (action_result
      REFLECTION_SUCCESS / REFLECTION_FAILED / REFLECTION_SKIPPED). Without that
      exclusion the job feeds itself: the window is longer than a day, so last night's
      audit row alone would qualify the agent again tonight, and an agent that acted
      once would be reflected on - and billed - every night for ever.

      Keyset pagination on id, so a run can walk every candidate instead of starving
      everyone after the first page. Token exhaustion is re-checked per agent by the
      scheduler, because used_tokens moves between this query and the call.
    -->
    <select id="findAliveAgentsActiveSince" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents a
        WHERE a.status = 1
          AND a.deleted = 0
          AND a.id &gt; #{afterId}
          AND EXISTS (
              SELECT 1 FROM agent_logs al
              WHERE al.agent_id = a.id
                AND al.created_at &gt;= #{since}
                AND (al.action_result IS NULL OR al.action_result NOT LIKE 'REFLECTION%')
          )
        ORDER BY a.id ASC
        LIMIT #{limit}
    </select>

    <!--
      The same candidate set, ordered by how long each agent has waited for a reflection.

      ORDER BY: never-attempted agents first (last_reflection_attempt_at IS NOT NULL sorts
      false=0 before true=1), then oldest attempt, then id as the tiebreaker so the order
      is total and the keyset below can never skip or repeat a row.

      The WHERE has three parts:
      - the same activity + liveness predicate as findAliveAgentsActiveSince;
      - attemptedBefore, which excludes agents this run has already stamped. Stamping sets
        the cursor to "now", which moves the agent to the END of this ordering - i.e. after
        the paging cursor - so without this predicate a run would keep re-selecting its own
        finished work;
      - the composite keyset, in two shapes. While the cursor is still inside the
        never-attempted block (afterAttemptAt IS NULL) the next page is "the rest of that
        block by id, plus everything that has ever been attempted". Once past it, it is the
        ordinary (time, id) &gt; (time, id) comparison spelled out.
    -->
    <select id="findAliveAgentsActiveSinceByReflectionCursor" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents a
        WHERE a.status = 1
          AND a.deleted = 0
          AND (a.last_reflection_attempt_at IS NULL
               OR a.last_reflection_attempt_at &lt; #{attemptedBefore})
        <if test="hasCursor">
            <choose>
                <when test="afterAttemptAt == null">
                    AND (a.last_reflection_attempt_at IS NOT NULL
                         OR a.id &gt; #{afterId})
                </when>
                <otherwise>
                    AND a.last_reflection_attempt_at IS NOT NULL
                    AND (a.last_reflection_attempt_at &gt; #{afterAttemptAt}
                         OR (a.last_reflection_attempt_at = #{afterAttemptAt}
                             AND a.id &gt; #{afterId}))
                </otherwise>
            </choose>
        </if>
          AND EXISTS (
              SELECT 1 FROM agent_logs al
              WHERE al.agent_id = a.id
                AND al.created_at &gt;= #{since}
                AND (al.action_result IS NULL OR al.action_result NOT LIKE 'REFLECTION%')
          )
        ORDER BY a.last_reflection_attempt_at IS NOT NULL, a.last_reflection_attempt_at ASC, a.id ASC
        LIMIT #{limit}
    </select>

    <select id="countAliveAgentsActiveSince" resultType="int">
        SELECT COUNT(*) FROM agents a
        WHERE a.status = 1
          AND a.deleted = 0
          AND EXISTS (
              SELECT 1 FROM agent_logs al
              WHERE al.agent_id = a.id
                AND al.created_at &gt;= #{since}
                AND (al.action_result IS NULL OR al.action_result NOT LIKE 'REFLECTION%')
          )
    </select>

    <!--
      Rhythm wake candidates. Only the parts an index can serve are here; the active-hours
      window (which may wrap midnight) and the daily budget are decided in Java.

      next_wake_at IS NULL is a candidate on purpose: an agent created before the
      migration, or one whose schedule was never computed, must get a first turn.
    -->
    <select id="findRhythmWakeCandidates" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents
        WHERE status = 1
          AND deleted = 0
          AND (is_unlimited = TRUE OR used_tokens &lt; token_threshold)
          AND (next_wake_at IS NULL OR next_wake_at &lt;= #{now})
        ORDER BY next_wake_at IS NOT NULL, next_wake_at ASC, id ASC
        LIMIT #{limit}
    </select>

    <select id="findAliveAgentsByIds" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents
        WHERE status = 1
          AND deleted = 0
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id ASC
    </select>

        <!--
      Fallback for databases without the last_dispatched_at column (migration not
      applied). Keeps the loop working at the cost of a full scan + temp table.
    -->
    <select id="findRandomActiveAgentsLegacy" resultType="com.pulse.entity.Agent">
        SELECT * FROM agents
        WHERE status = 1
          AND deleted = 0
          AND (is_unlimited = TRUE OR used_tokens &lt; token_threshold)
        ORDER BY RAND()
        LIMIT #{limit}
    </select>

</mapper>