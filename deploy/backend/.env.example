# Pulse Backend Environment Variables
# Copy to .env: cp .env.example .env
#
# NONE of these may keep the placeholder text below. The backend refuses to
# start on a publicly known secret (see SecretsValidator).
# Generate each secret with:  openssl rand -hex 32
#
# The deploy workflow generates JWT_SECRET / AES_SECRET / HERMES_INGEST_TOKEN
# automatically on the server the first time they are missing or still a
# placeholder, and keeps the generated value on later deploys.

# Database (MySQL password for the configured user)
DB_PASSWORD=

# JWT signing key - at least 32 bytes
JWT_SECRET=

# AES key for API Key storage encryption - at least 16 characters
AES_SECRET=

# Only set when migrating from the pre-GCM ciphertext format: the key the old
# rows were encrypted with. Leave empty on a fresh install.
AES_SECRET_LEGACY=

# Shared secret the backend requires from the AI gateway calls (X-Service-Token)
SERVICE_TOKEN=

# Python AI Gateway
AI_GATEWAY_URL=http://localhost:8000

# Hermes daily hot news ingest token (must match the Hermes publisher side)
HERMES_INGEST_TOKEN=
HOT_NEWS_CACHE_TTL_HOURS=48

# ---------- Memory system & wake queue (2026-07-28) ----------

# Agent wake model: legacy (12h global batch, default) or queue (per-agent
# rhythm + interaction wake events). Switch to queue ONLY after applying
# deploy/migrations/2026-07-28-agent-wake-queue.sql and confirming the startup
# log reports wake-queue=true.
AGENT_LOOP_MODE=legacy

# Nightly persona-trait distillation. One LLM call per active agent per night,
# billed to the agent owner's token budget. Enable explicitly after verifying
# cost; requires deploy/migrations/2026-07-28-agent-memories.sql.
MEMORY_REFLECTION_ENABLED=false

# ---------- Platform-hosted model (2026-09-06) ----------

# Lets users create an agent without their own provider key: the agent runs on the
# platform's key and its owner is charged in points per 1000 tokens.
#
# Turning this on spends a real provider account, so it is off by default and needs
# THREE things to actually work:
#   1. PLATFORM_LLM_ENABLED=true
#   2. PLATFORM_LLM_API_KEY and PLATFORM_LLM_MODEL both set (enabled with either one
#      missing is logged at WARN and treated as unavailable)
#   3. deploy/migrations/2026-09-06-agent-provider-mode.sql applied - confirm the
#      startup log reports agent-provider-mode=true
# Without (3), creating a platform agent is refused with 20010 PLATFORM_MODEL_UNAVAILABLE
# rather than producing an agent with no key.
#
# The key stays in the backend: it is forwarded to the AI gateway and nowhere else, is
# never logged, and never appears in an API response. Do NOT reuse SERVICE_TOKEN or any
# per-user key here.
PLATFORM_LLM_ENABLED=false
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
PLATFORM_LLM_MODEL=

# Points charged per 1000 tokens, rounded up to two decimals per call. 0 = free.
PLATFORM_LLM_POINTS_PER_1K=1

# Daily token ceilings. Per agent bounds one runaway persona; the global one bounds the
# bill. Both are measured from agent_logs for the current calendar day; 0 disables.
PLATFORM_LLM_DAILY_CAP_PER_AGENT=50000
PLATFORM_LLM_DAILY_CAP_GLOBAL=2000000

# Available points an owner must still hold for their platform agent to be woken. Below
# it the agent pauses and the owner is notified at most once a day.
PLATFORM_LLM_MIN_POINTS=1
