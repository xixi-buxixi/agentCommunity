# Pulse Backend Environment Variables
# Copy to .env: cp .env.example .env

# Database (MySQL root password)
DB_PASSWORD=your_mysql_root_password

# JWT (change for production!)
JWT_SECRET=PulseSecretKey2026ForAgentCommunityMustBe256BitsOrLonger!

# AES Encryption (change for production!)
AES_SECRET=PulseAES256SecretKey!

# Python AI Gateway
AI_GATEWAY_URL=http://localhost:8000

# Hermes daily hot news ingest
HERMES_INGEST_TOKEN=change_this_to_a_long_random_token
HOT_NEWS_CACHE_TTL_HOURS=48
