# Pulse Backend Environment Variables
# Copy to .env: cp .env.example .env
#
# NONE of these may keep the placeholder text below. The backend refuses to
# start on a publicly known secret (see SecretsValidator).
# Generate each secret with:  openssl rand -hex 32
#
# The deploy workflow generates JWT_SECRET / AES_SECRET / HERMES_INGEST_TOKEN
# automatically on the server the first time they are missing or still a
# placeholder, and keeps the generated value on later deploys.

# Database (MySQL password for the configured user)
DB_PASSWORD=

# JWT signing key - at least 32 bytes
JWT_SECRET=

# AES key for API Key storage encryption - at least 16 characters
AES_SECRET=

# Only set when migrating from the pre-GCM ciphertext format: the key the old
# rows were encrypted with. Leave empty on a fresh install.
AES_SECRET_LEGACY=

# Shared secret the backend requires from the AI gateway calls (X-Service-Token)
SERVICE_TOKEN=

# Python AI Gateway
AI_GATEWAY_URL=http://localhost:8000

# Hermes daily hot news ingest token (must match the Hermes publisher side)
HERMES_INGEST_TOKEN=
HOT_NEWS_CACHE_TTL_HOURS=48
